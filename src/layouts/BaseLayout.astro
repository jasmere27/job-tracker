---
import '../styles/global.css';

interface Props {
	title?: string;
}

const { title = 'Job Application Tracker' } = Astro.props;

const ICONS: Record<string, string> = {
	dashboard: '<rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/>',
	applications: '<line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>',
	board: '<rect x="3" y="3" width="18" height="18" rx="2"/><line x1="9" y1="3" x2="9" y2="21"/><line x1="15" y1="3" x2="15" y2="21"/>'
};

const navItems = [
	{ href: '/', label: 'Dashboard', icon: 'dashboard' },
	{ href: '/applications', label: 'Applications', icon: 'applications' },
	{ href: '/applications/board', label: 'Board', icon: 'board' }
];
const currentPath = Astro.url.pathname;
const activeHref = navItems
	.filter((item) => (item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href)))
	.sort((a, b) => b.href.length - a.href.length)[0]?.href;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="min-h-screen bg-canvas font-sans text-ink antialiased">
		{
			Astro.locals.user ? (
				<div class="lg:flex lg:min-h-screen">
					<aside class="hidden lg:flex lg:w-60 lg:flex-shrink-0 lg:flex-col lg:bg-ink">
						<div class="flex items-center gap-2 px-5 py-5">
							<span class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-md bg-accent">
								<svg viewBox="0 0 24 24" fill="none" class="h-4 w-4">
									<path
										d="M6 15L11 10L15 14L19 8"
										stroke="white"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
									/>
								</svg>
							</span>
							<span class="text-sm font-semibold leading-tight tracking-tight text-white">Job Application Tracker</span>
						</div>
						<nav class="mt-2 flex flex-1 flex-col gap-0.5 px-3">
							{navItems.map((item) => {
								const isActive = item.href === activeHref;
								return (
									<a
										href={item.href}
										class={`flex items-center gap-2.5 rounded-md px-3 py-2 text-sm font-medium transition-colors ${
											isActive ? 'bg-white/10 text-white' : 'text-white/55 hover:bg-white/5 hover:text-white'
										}`}
									>
										<svg
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="1.75"
											stroke-linecap="round"
											stroke-linejoin="round"
											class="h-[18px] w-[18px] flex-shrink-0"
											set:html={ICONS[item.icon]}
										/>
										{item.label}
									</a>
								);
							})}
						</nav>
						<div class="mt-auto border-t border-white/10 px-3 py-3">
							<form method="POST" action="/api/auth/signout">
								<button
									type="submit"
									class="flex w-full items-center gap-2.5 rounded-md px-3 py-2 text-sm font-medium text-white/55 transition-colors hover:bg-white/5 hover:text-white"
								>
									<svg
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="1.75"
										stroke-linecap="round"
										stroke-linejoin="round"
										class="h-[18px] w-[18px] flex-shrink-0"
									>
										<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
										<polyline points="16 17 21 12 16 7" />
										<line x1="21" y1="12" x2="9" y2="12" />
									</svg>
									Sign out
								</button>
							</form>
						</div>
					</aside>

					<div class="flex min-h-screen flex-1 flex-col bg-canvas lg:min-h-0">
						<header class="flex items-center justify-between border-b border-line bg-surface px-4 py-3 lg:hidden">
							<div class="flex min-w-0 items-center gap-2">
								<span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-md bg-accent">
									<svg viewBox="0 0 24 24" fill="none" class="h-3.5 w-3.5">
										<path
											d="M6 15L11 10L15 14L19 8"
											stroke="white"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
								</span>
								<span class="truncate text-sm font-semibold tracking-tight text-ink">Job Application Tracker</span>
							</div>
							<form method="POST" action="/api/auth/signout">
								<button
									type="submit"
									class="text-xs font-medium text-muted transition-colors hover:text-ink"
								>
									Sign out
								</button>
							</form>
						</header>
						<nav class="flex items-center gap-1 overflow-x-auto border-b border-line bg-surface px-3 py-2 lg:hidden">
							{navItems.map((item) => {
								const isActive = item.href === activeHref;
								return (
									<a
										href={item.href}
										class={`flex flex-shrink-0 items-center gap-1.5 rounded-md px-3 py-1.5 text-sm font-medium transition-colors ${
											isActive ? 'bg-accent-soft text-accent-dim' : 'text-muted hover:bg-canvas hover:text-ink'
										}`}
									>
										<svg
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="1.75"
											stroke-linecap="round"
											stroke-linejoin="round"
											class="h-4 w-4 flex-shrink-0"
											set:html={ICONS[item.icon]}
										/>
										{item.label}
									</a>
								);
							})}
						</nav>
						<main class="flex-1">
							<slot />
						</main>
					</div>
				</div>
			) : (
				<slot />
			)
		}
	</body>
</html>
