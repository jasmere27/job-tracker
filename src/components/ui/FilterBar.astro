---
import { STATUS_VALUES, type ApplicationStatus } from '../../lib/supabase/types';

interface Props {
	activeStatus: ApplicationStatus | 'all';
}

const { activeStatus } = Astro.props;

const LABELS: Record<ApplicationStatus | 'all', string> = {
	all: 'All',
	applied: 'Applied',
	phone_screen: 'Phone Screen',
	interview: 'Interview',
	offer: 'Offer',
	rejected: 'Rejected'
};

const options: (ApplicationStatus | 'all')[] = ['all', ...STATUS_VALUES];
---

<nav class="mt-5 inline-flex flex-wrap gap-1 rounded-lg border border-line bg-canvas p-1 text-sm">
	{
		options.map((status) => (
			<a
				href={status === 'all' ? '/applications' : `/applications?status=${status}`}
				class={`rounded-md px-3 py-1.5 font-medium transition-colors ${
					status === activeStatus
						? 'bg-surface text-ink shadow-sm'
						: 'text-muted hover:text-ink'
				}`}
			>
				{LABELS[status]}
			</a>
		))
	}
</nav>
